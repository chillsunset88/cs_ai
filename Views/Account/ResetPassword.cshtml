@{
    Layout = null;
    var token = ViewBag.Token as string;
    var username = ViewBag.Username as string;
    var valid = ViewBag.TokenInvalid != true && !string.IsNullOrEmpty(token);
    var step = ViewBag.Step as string ?? "otp";
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Reset Password</title>
    <style>
        :root {
            --bg: #f3f5f9; --card: #ffffff; --text: #1c2333; --muted: #667085; --line: #d6dbe5;
            --brand: #2563eb; --brand-dark: #1d4ed8; --ok: #15803d; --bad: #b42318; --bad-bg: #fef3f2; --ok-bg: #f0fdf4;
        }
        @@media (prefers-color-scheme: dark) {
            :root {
                --bg: #0f1420; --card: #181f2e; --text: #e8ecf4; --muted: #98a2b3; --line: #2c3547;
                --brand: #4f8cff; --brand-dark: #3b78ee; --ok: #4ade80; --bad: #fda29b; --bad-bg: #3a1a18; --ok-bg: #12301e;
            }
        }
        * { box-sizing: border-box; }
        body {
            margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 16px;
            background: var(--bg); color: var(--text);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; line-height: 1.5;
        }
        .card { width: 100%; max-width: 420px; background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 28px 24px; box-shadow: 0 8px 30px rgba(16, 24, 40, .08); }
        h1 { margin: 0 0 4px; font-size: 1.4rem; text-align: center; }
        .sub { margin: 0 0 20px; text-align: center; color: var(--muted); font-size: .92rem; }
        label { display: block; margin: 14px 0 6px; font-size: .88rem; font-weight: 600; }
        .field { position: relative; }
        input[type=password], input[type=text] {
            width: 100%; padding: 11px 70px 11px 12px; font-size: 1rem; color: var(--text); background: transparent;
            border: 1px solid var(--line); border-radius: 10px; outline: none;
        }
        input[readonly] { padding-right: 12px; background: var(--bg); color: var(--muted); }
        input:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(37, 99, 235, .18); }
        .toggle { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); border: 0; background: none; color: var(--brand); font-size: .82rem; font-weight: 600; cursor: pointer; padding: 6px 8px; }
        ul.rules { list-style: none; margin: 10px 0 0; padding: 0; font-size: .84rem; color: var(--muted); }
        ul.rules li::before { content: "○ "; }
        ul.rules li.ok { color: var(--ok); }
        ul.rules li.ok::before { content: "● "; }
        .hint { margin-top: 6px; font-size: .84rem; min-height: 1.2em; color: var(--bad); }
        button.submit { width: 100%; margin-top: 20px; padding: 12px; font-size: 1rem; font-weight: 600; color: #fff; background: var(--brand); border: 0; border-radius: 10px; cursor: pointer; }
        button.submit:hover:not(:disabled) { background: var(--brand-dark); }
        button.submit:disabled { opacity: .5; cursor: not-allowed; }
        .alert { margin-top: 16px; padding: 12px 14px; border-radius: 10px; font-size: .92rem; text-align: center; }
        .alert.bad { color: var(--bad); background: var(--bad-bg); }
        .alert.ok { color: var(--ok); background: var(--ok-bg); }
        .foot { margin-top: 18px; text-align: center; color: var(--muted); font-size: .8rem; }
    </style>
</head>
<body>
<main class="card">
    <h1>Reset Password</h1>

    @if (!valid)
    {
        <p class="sub">Link tidak dapat digunakan</p>
        <div class="alert bad">
            Link reset password tidak valid, sudah dipakai, atau sudah kedaluwarsa.
            Kembali ke bot Telegram dan minta reset password lagi.
        </div>
    }
    else if (step == "otp")
    {
        <p class="sub">Masukkan kode OTP yang dikirim ke WhatsApp Anda</p>

        <form method="post" action="@Url.Action("VerifyOtp", "Account")" autocomplete="off">
            <input type="hidden" name="Token" value="@token" />

            <label for="u">Username</label>
            <input id="u" type="text" value="@username" readonly />

            <label for="o">Kode OTP</label>
            <input id="o" name="Otp" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
                   autocomplete="one-time-code" required autofocus
                   style="padding-right:12px;letter-spacing:.35em;font-size:1.3rem;text-align:center" />

            <button type="submit" class="submit">Verifikasi</button>
        </form>

        if (ViewBag.Message != null)
        {
            <div class="alert bad">@ViewBag.Message</div>
        }

        <p class="foot">Kode berlaku beberapa menit dan hanya dapat dicoba 3 kali.</p>
    }
    else
    {
        <p class="sub">Kode OTP benar. Buat password baru untuk akun Anda</p>

        <form method="post" action="@Url.Action("ResetPassword", "Account")" id="form" autocomplete="off" novalidate>
            <input type="hidden" name="Token" value="@token" />

            <label for="u">Username</label>
            <input id="u" type="text" value="@username" readonly />

            <label for="p">Password baru</label>
            <div class="field">
                <input id="p" name="Password" type="password" autocomplete="new-password" required />
                <button type="button" class="toggle" data-target="p">Lihat</button>
            </div>
            <ul class="rules" id="rules">
                <li data-rule="len">Minimal 8 karakter</li>
                <li data-rule="upper">Huruf besar (A-Z)</li>
                <li data-rule="lower">Huruf kecil (a-z)</li>
                <li data-rule="digit">Angka atau simbol</li>
            </ul>

            <label for="c">Konfirmasi password</label>
            <div class="field">
                <input id="c" name="ConfirmPassword" type="password" autocomplete="new-password" required />
                <button type="button" class="toggle" data-target="c">Lihat</button>
            </div>
            <div class="hint" id="match"></div>

            <button type="submit" class="submit" id="go" disabled>Simpan password baru</button>
        </form>

        if (ViewBag.Message != null)
        {
            <div class="alert @(ViewBag.Success == true ? "ok" : "bad")">@ViewBag.Message</div>
        }

        <p class="foot">Link ini sekali pakai. Jangan bagikan kepada siapa pun.</p>

        <script>
            (function () {
                var p = document.getElementById('p'), c = document.getElementById('c');
                var go = document.getElementById('go'), match = document.getElementById('match');
                var checks = {
                    len: function (v) { return v.length >= 8; },
                    upper: function (v) { return /[A-Z]/.test(v); },
                    lower: function (v) { return /[a-z]/.test(v); },
                    digit: function (v) { return /[0-9\W_]/.test(v); }
                };

                function update() {
                    var all = true;
                    document.querySelectorAll('#rules li').forEach(function (li) {
                        var ok = checks[li.dataset.rule](p.value);
                        li.classList.toggle('ok', ok);
                        all = all && ok;
                    });
                    var same = c.value.length > 0 && p.value === c.value;
                    match.textContent = c.value.length > 0 && !same ? 'Konfirmasi password belum sama.' : '';
                    go.disabled = !(all && same);
                }

                p.addEventListener('input', update);
                c.addEventListener('input', update);

                document.querySelectorAll('.toggle').forEach(function (b) {
                    b.addEventListener('click', function () {
                        var el = document.getElementById(b.dataset.target);
                        var show = el.type === 'password';
                        el.type = show ? 'text' : 'password';
                        b.textContent = show ? 'Sembunyi' : 'Lihat';
                    });
                });

                document.getElementById('form').addEventListener('submit', function () {
                    go.disabled = true;
                    go.textContent = 'Memproses...';
                });
                update();
            })();
        </script>
    }
</main>
</body>
</html>
