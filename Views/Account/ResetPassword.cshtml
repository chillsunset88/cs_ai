@model CS_AI.Models.UserModel

@{
    var token = ViewBag.Token as string;
    var lockedUsername = ViewBag.Username as string;
    var tokenMode = !string.IsNullOrEmpty(token);
}

<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg p-4 rounded-4" style="width: 100%; max-width: 420px;">
        <div class="text-center mb-4">
            <h3 class="fw-bold">Reset Password</h3>
            <p class="text-muted small">Enter your new password below</p>
        </div>

        @if (ViewBag.TokenInvalid == true)
        {
            <div class="alert alert-danger text-center">
                Link reset password tidak valid atau sudah kedaluwarsa. Silakan minta reset ulang lewat bot.
            </div>
        }
        else
        {
            <form asp-action="ResetPassword" method="post">
                @if (tokenMode)
                {
                    <input type="hidden" name="Token" value="@token" />
                }

                <div class="mb-3">
                    <label class="form-label">Username</label>
                    @if (tokenMode)
                    {
                        <input type="text" class="form-control form-control-lg" value="@lockedUsername" readonly />
                    }
                    else
                    {
                        <input type="text" name="Username" class="form-control form-control-lg" required />
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label">New Password</label>
                    <input type="password" name="Password" class="form-control form-control-lg" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirm Password</label>
                    <input type="password" name="ConfirmPassword" class="form-control form-control-lg" required />
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary btn-lg rounded-3">Reset Password</button>
                </div>
            </form>
        }

        @if (ViewBag.Message != null)
        {
            var alertClass = ViewBag.Success == true ? "alert-success" : "alert-danger";
            <div class="alert @alertClass mt-4 text-center">
                @ViewBag.Message
            </div>
        }
    </div>
</div>
