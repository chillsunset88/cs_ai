@{
    ViewData["Title"] = "Password Reset Successful";
}

<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg p-5 rounded-4 text-center" style="width: 100%; max-width: 420px;">
        <div class="mb-4">
            <div class="display-1 text-success">
                <i class="bi bi-check-circle-fill"></i>
            </div>
        </div>

        <h3 class="fw-bold">All Set!</h3>
        <p class="text-muted">Your password has been changed successfully. You can now log in to your account with your new password.</p>

        <hr class="my-4 text-muted opacity-25">

        <div class="d-grid">
            <a asp-action="Login" asp-controller="User" class="btn btn-primary btn-lg rounded-3 shadow-sm">
                Back to Login
            </a>
        </div>
    </div>
</div>